rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to get user data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper function to check if user is super admin
    function isSuperAdmin() {
      return isSignedIn() && getUserData().role == 'super_admin' && getUserData().isActive == true;
    }

    // Helper function to check if user is admin or super admin
    function isAdmin() {
      return isSignedIn() &&
             (getUserData().role == 'super_admin' || getUserData().role == 'admin') &&
             getUserData().isActive == true;
    }

    // Helper function to check if user has at least manager role
    function isManager() {
      return isSignedIn() &&
             getUserData().role in ['super_admin', 'admin', 'manager'] &&
             getUserData().isActive == true;
    }

    // Helper function to check if user is active
    function isActiveUser() {
      return isSignedIn() && getUserData().isActive == true;
    }

    // Helper function to check if any users exist in the database
    function noUsersExist() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Users collection rules
    match /users/{userId} {
      // Allow read if user is authenticated
      allow read: if isSignedIn();

      // Allow create if:
      // 1. Creating your own profile after Firebase Auth registration, OR
      // 2. User is super admin creating another user, OR
      // 3. This is the first user being created (super admin setup)
      allow create: if (isSignedIn() && request.auth.uid == userId) ||
                      isSuperAdmin() ||
                      (request.auth != null && request.resource.data.role == 'super_admin');

      // Allow update if:
      // 1. Super admin updating any user, OR
      // 2. User updating their own profile (but not their role or isActive status)
      allow update: if isSuperAdmin() ||
                      (isSignedIn() &&
                       request.auth.uid == userId &&
                       request.resource.data.role == resource.data.role &&
                       request.resource.data.isActive == resource.data.isActive);

      // Only super admin can delete users
      allow delete: if isSuperAdmin();
    }

    // Cold Storage Master Data
    match /cold_storages/{storageId} {
      allow read: if isActiveUser();
      allow write: if isManager();
    }

    // Brand Master Data
    match /brands/{brandId} {
      allow read: if isActiveUser();
      allow write: if isManager();
    }

    // Item Master Data
    match /items/{itemId} {
      allow read: if isActiveUser();
      allow write: if isManager();
    }

    // Party Master Data
    match /parties/{partyId} {
      allow read: if isActiveUser();
      allow write: if isManager();
    }

    // Receipt Entries
    match /receipts/{receiptId} {
      allow read: if isActiveUser();
      allow create: if isManager();
      allow update, delete: if isManager();
    }

    // Delivery Entries
    match /deliveries/{deliveryId} {
      allow read: if isActiveUser();
      allow create: if isManager();
      allow update, delete: if isManager();
    }

    // Product Master Data
    match /products/{productId} {
      allow read: if isActiveUser();
      allow write: if isManager();
    }

    // Company Master Data
    match /companies/{companyId} {
      allow read: if isActiveUser();
      allow write: if isManager();
    }

    // Rent Rate Master Data
    match /rent_rates/{rateId} {
      allow read: if isActiveUser();
      allow write: if isManager();
    }

    // Rent Bills
    match /rent_bills/{billId} {
      allow read: if isActiveUser();
      allow create: if isManager();
      allow update, delete: if isManager();
    }

    // System Settings (only super admin)
    match /settings/{settingId} {
      allow read: if isActiveUser();
      allow write: if isSuperAdmin();
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
